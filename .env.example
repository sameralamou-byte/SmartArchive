# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=smartarchive
POSTGRES_PASSWORD=smartarchive_dev_password
POSTGRES_DB=smartarchive
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MinIO ---
MINIO_ROOT_USER=smartarchive
MINIO_ROOT_PASSWORD=smartarchive_dev_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=smartarchive-documents
MINIO_USE_SSL=false

# --- JWT ---
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
