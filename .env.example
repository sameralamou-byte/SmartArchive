# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=smartarchive
POSTGRES_PASSWORD=smartarchive_dev_password
POSTGRES_DB=smartarchive
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MinIO ---
MINIO_ROOT_USER=smartarchive
MINIO_ROOT_PASSWORD=smartarchive_dev_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=smartarchive-documents
MINIO_USE_SSL=false

# --- JWT ---
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- CORS (Milestone 1.5) ---
# Comma-separated explicit allowlist -- never "*" outside local dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- SA-AUTH-001 email verification ---
# log = development (no network). smtp = real delivery via SMTP_*.
# Tests force memory in conftest; do not put secrets in this file.
PUBLIC_APP_ORIGIN=http://localhost:5174
EMAIL_FROM=smartarchive@localhost
EMAIL_DELIVERY_MODE=log
EMAIL_VERIFICATION_SECRET=change_email_verification_secret
PASSWORD_RESET_SECRET=change_password_reset_secret
SESSION_REFRESH_SECRET=change_session_refresh_secret
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Integration tests (Milestone 1.5) ---
# Point at a disposable database, never at one with real data.
# TEST_DATABASE_URL=postgresql+asyncpg://smartarchive:smartarchive_dev_password@localhost:5432/smartarchive_test
